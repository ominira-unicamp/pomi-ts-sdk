{
  "name": "@ominira/pomi-sdk",
  "version": "1.0.0-rc.1",
  "description": "Planejador da Ominira SDK",
  "homepage": "https://github.com/ominira-unicamp/pomi-ts-sdk#readme",
  "bugs": {
    "url": "https://github.com/ominira-unicamp/pomi-ts-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ominira-unicamp/pomi-ts-sdk.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "author": "goliasvictor",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./generated": {
      "types": "./dist/generated/index.d.ts",
      "import": "./dist/generated/index.js"
    },
    "./generated/app": {
      "types": "./dist/generated/app/index.d.ts",
      "import": "./dist/generated/app/index.js"
    },
    "./generated/data": {
      "types": "./dist/generated/data/index.d.ts",
      "import": "./dist/generated/data/index.js"
    },
    "./generated-client": {
      "types": "./dist/generatedClient.d.ts",
      "import": "./dist/generatedClient.js"
    },
    "./generated-pagination": {
      "types": "./dist/generatedPagination.d.ts",
      "import": "./dist/generatedPagination.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "export:openapi": "node --import tsx sdk-gen/exportOpenApi.ts",
    "generate": "node --import tsx sdk-gen/generate.ts",
    "generate:check": "node --import tsx sdk-gen/generate.ts --check",
    "generate:typecheck": "tsc --noEmit -p tsconfig.generated.json",
    "test:generator": "node --import tsx --test sdk-gen/*.test.ts",
    "architecture:check": "node scripts/check-architecture.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run architecture:check && npm run typecheck",
    "test": "node --import tsx --test src/generated*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "validate": "npm run test:generator && npm run check && npm test && npm run build",
    "release:verify": "node scripts/verify-release-version.mjs",
    "prepublishOnly": "npm run validate"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "openapi-typescript": "^7.13.0",
    "ts-morph": "^27.0.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "pomi",
    "ominira",
    "sdk",
    "unicamp",
    "typescript"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
